# Regenerate target-specific options with: idf.py set-target esp32s3
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-S3R8 has octal PSRAM; required to see the full 8 MB (DESIGN.md §2).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Board has 16 MB flash (DESIGN.md §2); default Kconfig is 2 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# No UART0 bridge wired on this board; native USB (USB-Serial/JTAG) is the
# only accessible console port, so make it primary (not just secondary).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Per-task runtime accounting, needed for sys_metrics' CPU usage gauge
# (DESIGN.md §7). Also pulls in configUSE_TRACE_FACILITY, needed for
# uxTaskGetSystemState().
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
