menu "net_eth: W5500 Ethernet (DESIGN.md §2)"

    config NET_ETH_SPI_HOST
        int "SPI host (1 = SPI2_HOST, 2 = SPI3_HOST)"
        range 1 2
        default 1
        help
            Which SPI peripheral the W5500 is wired to. On the reference
            Waveshare board it's a dedicated bus, separate from any
            general-purpose SPI exposed for sensors (DESIGN.md §13).

    config NET_ETH_SPI_SCLK_GPIO
        int "W5500 SPI SCLK GPIO"
        default 13

    config NET_ETH_SPI_MOSI_GPIO
        int "W5500 SPI MOSI GPIO"
        default 11

    config NET_ETH_SPI_MISO_GPIO
        int "W5500 SPI MISO GPIO"
        default 12

    config NET_ETH_SPI_CS_GPIO
        int "W5500 SPI CS GPIO"
        default 14

    config NET_ETH_SPI_CLOCK_MHZ
        int "W5500 SPI clock speed (MHz)"
        default 20

    config NET_ETH_INT_GPIO
        int "W5500 INT GPIO (-1 to poll instead of using an interrupt)"
        default 10

    config NET_ETH_RST_GPIO
        int "W5500 RST GPIO (-1 for no hardware reset line)"
        default 9

    config NET_ETH_NTP_SERVER
        string "NTP server hostname (DESIGN.md §6.4)"
        default "pool.ntp.org"

endmenu
